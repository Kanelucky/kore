<configuration>
    <!-- Names each run's log file after the moment the server started. -->
    <timestamp key="started" datePattern="yyyy-MM-dd_HH-mm-ss"/>

    <!-- What's happening, without the detail. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%logger{20}) - %msg%n</pattern>
        </encoder>
    </appender>

    <!--
        Everything, one file per run, to read back after testing: requests, SDP offers,
        connection steps and every packet batch in and out (the org.koremc.packets logger).
    -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs/kore-${started}.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="io.netty" level="WARN"/>
    <logger name="org.koremc" level="DEBUG"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>
</configuration>
